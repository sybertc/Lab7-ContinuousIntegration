@inherits LayoutComponentBase

<div class="app-layout">
    <nav class="sidebar">
        <NavMenu />
    </nav>

    <main class="content-area">
        @Body
    </main>
</div>

<div id="blazor-error-ui">
    An unhandled error has occurred.
    <a href="" class="reload">Reload</a>
    <a class="dismiss">🗙</a>
</div>

<style>
    .app-layout {
        display: flex;
        height: 100vh;
        margin: 0;
        padding: 0;
    }

    /* Force a single color for the sidebar with no gradient */
    .sidebar {
        background-color: var(--navy) !important;
        background-image: none !important; /* In case there's a leftover gradient */
        width: 250px;
        height: 100vh;
        position: fixed;
        top: 0;
        left: 0;
        color: var(--off-white);
        overflow-y: auto; /* scroll if NavMenu is tall */
        padding: 1rem;
        box-sizing: border-box;
    }

    .content-area {
        margin-left: 250px; /* match sidebar width */
        flex: 1;
        overflow-y: auto;
        padding: 1rem;
        background-color: var(--off-white);
    }
</style>
