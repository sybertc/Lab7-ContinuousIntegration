@page "/books/create"
@using Lab5_WebAppDevelopment.Models
@using Lab5_WebAppDevelopment.Services
@inject ILibraryService LibraryService
@inject NavigationManager Navigation
@rendermode InteractiveServer

<h3>Add New Book</h3>

<EditForm Model="newBook" OnValidSubmit="HandleValidSubmit">
    <DataAnnotationsValidator />
    <ValidationSummary />

    <div class="form-group">
        <label>Title:</label>
        <InputText class="form-control" @bind-Value="newBook.Title" />
    </div>
    <div class="form-group">
        <label>Author:</label>
        <InputText class="form-control" @bind-Value="newBook.Author" />
    </div>
    <div class="form-group">
        <label>ISBN:</label>
        <InputText class="form-control" @bind-Value="newBook.ISBN" />
    </div>

    <div class="action-buttons">
        <button type="submit" class="btn-index">Add Book</button>
        <button type="button" class="btn-index" @onclick="Cancel">Cancel</button>
    </div>
</EditForm>

@code {
    private Book newBook = new Book();

    private void HandleValidSubmit()
    {
        LibraryService.AddBook(newBook);
        Navigation.NavigateTo("/books");
    }

    private void Cancel()
    {
        Navigation.NavigateTo("/books");
    }
}
