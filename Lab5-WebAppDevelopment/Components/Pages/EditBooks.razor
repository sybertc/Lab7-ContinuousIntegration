@rendermode InteractiveServer
@page "/books/edit/{BookId:int}"
@using Lab5_WebAppDevelopment.Models
@using Lab5_WebAppDevelopment.Services
@inject ILibraryService LibraryService
@inject NavigationManager Navigation

<h3>Edit Book</h3>

@if (book == null)
{
    <p>Loading book information...</p>
}
else
{
    <EditForm Model="book" OnValidSubmit="HandleValidSubmit" FormName="EditBookForm">
        <DataAnnotationsValidator />
        <ValidationSummary />
        <div class="form-group">
            <label>Title:</label>
            <InputText class="form-control" @bind-Value="book.Title" />
        </div>
        <div class="form-group">
            <label>Author:</label>
            <InputText class="form-control" @bind-Value="book.Author" />
        </div>
        <div class="form-group">
            <label>ISBN:</label>
            <InputText class="form-control" @bind-Value="book.ISBN" />
        </div>
        <div class="action-buttons">
            <button class="btn-index" type="submit">Save</button>
            <button class="btn-index" type="button" @onclick="Cancel">Cancel</button>
        </div>
    </EditForm>
}

@code {
    [Parameter]
    public int BookId { get; set; }

    private Book book;

    protected override void OnInitialized()
    {
        book = LibraryService.Books.FirstOrDefault(b => b.Id == BookId);
        if (book == null)
        {
            book = LibraryService.BorrowedBooks
                      .SelectMany(kvp => kvp.Value)
                      .FirstOrDefault(b => b.Id == BookId);
        }
    }

    private void HandleValidSubmit()
    {
        LibraryService.EditBook(book);
        Navigation.NavigateTo("/books");
    }
    private void Cancel() => Navigation.NavigateTo("/books");
}
