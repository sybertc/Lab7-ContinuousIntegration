@rendermode InteractiveServer
@page "/users/edit/{UserId:int}"
@using Lab5_WebAppDevelopment.Models
@using Lab5_WebAppDevelopment.Services
@inject ILibraryService LibraryService
@inject NavigationManager Navigation

<h3>Edit User</h3>

@if (user == null)
{
    <p>Loading user information...</p>
}
else
{
    <EditForm Model="user" OnValidSubmit="HandleValidSubmit" FormName="EditUserForm">
        <DataAnnotationsValidator />
        <ValidationSummary />
        <div class="form-group">
            <label>Name:</label>
            <InputText class="form-control" @bind-Value="user.Name" />
        </div>
        <div class="form-group">
            <label>Email:</label>
            <InputText class="form-control" @bind-Value="user.Email" />
        </div>
        <div class="action-buttons">
            <button class="btn-index" type="submit">Save</button>
            <button class="btn-index" type="button" @onclick="Cancel">Cancel</button>
        </div>
    </EditForm>
}

@code {
    [Parameter]
    public int UserId { get; set; }
    private User user;

    protected override void OnInitialized()
    {
        user = LibraryService.Users.FirstOrDefault(u => u.Id == UserId);
    }
    private void HandleValidSubmit()
    {
        LibraryService.EditUser(user);
        Navigation.NavigateTo("/users");
    }
    private void Cancel() => Navigation.NavigateTo("/users");
}
